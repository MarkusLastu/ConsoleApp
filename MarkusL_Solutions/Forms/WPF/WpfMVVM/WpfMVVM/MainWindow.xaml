<Window x:Class="WpfMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfMVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel 
            Grid.Column="0" 
            Margin="0,0,20,0">

            <!-- <TextBlock 
                Text="Välj Katt:" 
                FontWeight="Bold" 
                Margin="0,0,0,5" />
            
            <ComboBox 
                ItemsSource="{Binding Cats}"
                DisplayMemberPath="Name"
                SelectedItem="{Binding SelectedCat}"
                Margin="0,0,0,15"/>
            -->

            <TextBlock 
                Text="Välj Katthem:" 
                FontWeight="Bold" 
                Margin="0,0,0,5" />
            
            <ComboBox 
                ItemsSource="{Binding Shelters}"
                DisplayMemberPath="Name"
                SelectedItem="{Binding SelectedShelter}"
                Margin="0,0,0,15"/>

            <TextBlock 
                Text="Välj Färg:" 
                FontWeight="Bold" 
                Margin="0,0,0,5" />
            
            <ComboBox 
                ItemsSource="{Binding Colors}"
                SelectedItem="{Binding SelectedColor}"
                Margin="0,0,0,15"/>

        </StackPanel>

        <StackPanel 
            Grid.Column="1" 
            Margin="20,0,0,0">

            <!-- <Button 
                Content="Sök per färg" 
                Command="{Binding LoadCatsByColorCommand}" 
                Margin="0,0,0,10" Padding="5"/>

            <Button 
                Content="Hämta katter från katthem"
                Command="{Binding LoadCatsByShelterIdCommand}"
                Margin="0,0,0,10" Padding="5"/>
            -->

            <Button 
                Content="Sök"
                Command="{Binding SearchCommand}"
                Margin="0,0,0,10" Padding="5"/>
            
            <Button 
                Content="Ladda alla katter" 
                Command="{Binding LoadCatsCommand}" 
                Margin="0,0,0,20" Padding="5"/>

            <TextBlock 
                Text="Resultat:" 
                FontWeight="Bold" 
                Margin="0,0,0,5" />
            
            <ListBox 
                ItemsSource="{Binding Cats}"
                SelectedItem="{Binding SelectedCat}" 
                DisplayMemberPath="Name" 
                Height="150" Margin="0,0,0,15"/>

            <TextBlock 
                Text="{Binding SelectedCat.Name}" 
                FontWeight="Bold" 
                FontSize="16" />
            
            <TextBlock 
                Text="{Binding SelectedCat.Age, 
                        StringFormat='Ålder: {0}'}" />
            
            <TextBlock 
                Text="{Binding SelectedCat.Color, 
                        StringFormat='Färg: {0}'}" />

            <TextBlock 
                Text="{Binding SelectedCat.Shelter.Id, 
                        StringFormat='Shelter ID: {0}'}" />

            <TextBlock 
                Text="{Binding SelectedCat.Shelter.Name, 
                        StringFormat='Shelter: {0}'}" />

        </StackPanel>
    </Grid>
</Window>