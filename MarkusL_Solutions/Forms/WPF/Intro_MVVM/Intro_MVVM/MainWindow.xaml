<Window x:Class="Intro_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Katter MVVM" Height="300" Width="400"
        Loaded="Window_Loaded">

    <StackPanel 
        Margin="20">
        
        <TextBlock 
            Text="Välj katt:" 
            FontSize="18"/>

        <ComboBox ItemsSource="{Binding Cats}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedCat}"
                  Height="30" 
                  Margin="0,10,0,20"/>

        <StackPanel 
            Orientation="Horizontal" 
            Margin="0,5">
            
            <TextBlock 
                Text="Namn: " 
                FontWeight="Bold" 
                Width="50"/>
            
            <TextBlock 
                Text="{Binding SelectedCat.Name}"/>
        </StackPanel>

        <StackPanel 
            Orientation="Horizontal" 
            Margin="0,5">
            
            <TextBlock 
                Text="Ålder: " 
                FontWeight="Bold" 
                Width="50"/>
            
            <TextBlock 
                Text="{Binding SelectedCat.Age}"/>
        </StackPanel>

        <StackPanel 
            Orientation="Horizontal" 
            Margin="0,5">
            
            <TextBlock 
                Text="Färg: " 
                FontWeight="Bold" 
                Width="50"/>
            
            <TextBlock 
                Text="{Binding SelectedCat.Color}"/>
        </StackPanel>

    </StackPanel>
</Window>