<Window x:Class="WpfMvvmDemo.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Katter"
 Height="300"
 Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Välj katt:" FontSize="18"/>
        <ComboBox ItemsSource="{Binding Cats}"
              DisplayMemberPath="Name"
              SelectedItem="{Binding SelectedCat}"
              Height="30"
              Margin="0,10,0,20"/>
        <TextBlock Text="{Binding SelectedCat.Name}"/>
        <TextBlock Text="{Binding SelectedCat.Age}"/>
        <TextBlock Text="{Binding SelectedCat.Color}"/>
    </StackPanel>
</Window>
