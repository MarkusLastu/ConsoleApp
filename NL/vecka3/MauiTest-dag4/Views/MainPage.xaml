<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTest_dag4.Views.MainPage"
             Title="Katthem">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Image Source="katt.jpg"
               HeightRequest="200"
               Aspect="AspectFit" />

        <Label Text="KATTHEM"
               FontSize="32"
               HorizontalOptions="Center" />

        <Button Text="Insert cat"
                Command="{Binding InsertCatCommand}" />

        <Button Text="Sök katt"
                Command="{Binding SearchCatCommand}" />
    </VerticalStackLayout>
</ContentPage>



