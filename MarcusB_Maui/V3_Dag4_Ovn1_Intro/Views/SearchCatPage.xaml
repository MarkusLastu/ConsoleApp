<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="V3_Dag4_Ovn1_Intro.Views.SearchCatPage"
             Title="SearchCatPage">

    <ScrollView>


        <VerticalStackLayout
        Padding="30"
        Spacing="20">

            <Image
            Source="search_cat.jpg"
            HeightRequest="200"
            Aspect="AspectFit"/>

            <Label
            Text="Sök katt"
            FontSize="30"
            HorizontalOptions="Center" />

            <Entry
            Placeholder="Ange kattens namn"
            Text="{Binding SearchText}" />

            <Button
            Text="Sök"
            Command="{Binding SearchCommand}" />

            <CollectionView
            ItemsSource="{Binding Cats}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <VerticalStackLayout Padding="10">

                            <Label
                            Text="{Binding Name}"
                            FontSize="20" />

                            <Label
                            Text="{Binding Age}" />

                            <Label
                            Text="{Binding Color}" />

                        </VerticalStackLayout>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
            Text="Tillbaka" 
            Command="{Binding BackCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>