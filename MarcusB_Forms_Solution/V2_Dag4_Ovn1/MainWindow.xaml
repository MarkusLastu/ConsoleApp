<Window x:Class="V2_Dag4_Ovn1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:V2_Dag4_Ovn1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Margin="20">
        <!-- Rader -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Rubrik -->
            <RowDefinition Height="Auto"/> <!-- Labels -->
            <RowDefinition Height="Auto"/> <!-- TextBoxar -->
            <RowDefinition Height="Auto"/> <!-- Knappar -->
            <RowDefinition Height="Auto"/> <!-- Avsluta -->
        </Grid.RowDefinitions> <!-- Kolumner -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label x:Name="lblKalkylator" 
                Content="Enkel Kalkylator" 
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"/>
        <Label x:Name="lblTal1" 
               Content="Tal 1" 
               Grid.Row="1"
               Grid.Column="0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
        <Label x:Name="lblTal2" 
               Content="Tal 2" 
               Grid.Row="1"
               Grid.Column="1"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
        <Label x:Name="lblResultat" 
               Content="Resultat" 
               Grid.Row="1"
               Grid.Column="2"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <TextBox x:Name="txtTal1" 
                 Grid.Row="2"
                 Grid.Column="0"
                 TextWrapping="Wrap"                  
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Width="120"/>           
        <TextBox x:Name="txtTal2" 
                 Grid.Row="2"
                 Grid.Column="1"
                 TextWrapping="Wrap" 
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Width="120"/>
        <TextBox x:Name="txtResultat" 
                 Grid.Row="2"
                 Grid.Column="2"
                 TextWrapping="Wrap" 
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Width="120"/>

        <UniformGrid Grid.Row="3"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Columns="4"
                 Margin="5">

            <Button x:Name="cmdPlus" Content="+" Click="cmdPlus_Click"/>
            <Button x:Name="cmdMinus" Content="-" Click="cmdMinus_Click"/>
            <Button x:Name="cmdDivision" Content="/" Click="cmdDivision_Click"/>
            <Button x:Name="cmdGanger" Content="*" Click="cmdGanger_Click"/>
        </UniformGrid>

        <Button x:Name="cmdAvsluta"
             Content="Avsluta"
             Grid.Row="4"
             Grid.Column="1"
             HorizontalAlignment="Center"
             VerticalAlignment="Bottom"
             Margin="5" 
             Click="cmdAvsluta_Click"/>

    </Grid>
</Window>
