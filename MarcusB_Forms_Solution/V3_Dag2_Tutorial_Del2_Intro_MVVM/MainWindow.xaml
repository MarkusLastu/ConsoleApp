<Window x:Class="V3_Dag2_Tutorial_Del2_Intro_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Katter"
        Height="300"
        Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Margin="20"
                    Grid.Column="0">
            <TextBlock Text="Välj katt:"
                   FontSize="18"
                   Margin="0,0,0,10"/>
            <ComboBox ItemsSource="{Binding Cats}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedCat}"
                  Height="30"
                  Margin="0,10,0,20"/>
            <TextBlock Text="{Binding SelectedCat.Name}"/>
            <TextBlock Text="{Binding SelectedCat.Age}"/>
            <TextBlock Text="{Binding SelectedCat.Color}"/>
        </StackPanel>

        <StackPanel Margin="20"
            Grid.Column="1">
            <TextBlock Text="Välj katthem:"
           FontSize="18"
           Margin="0,0,0,10"/>
            <ComboBox ItemsSource="{Binding Shelters}"
          DisplayMemberPath="Name"
          SelectedItem="{Binding SelectedShelter}"
          Height="30"
          Margin="0,10,0,20"/>
            <TextBlock Text="{Binding SelectedShelter.Name}"/>
            <TextBlock Text="{Binding SelectedShelter.City}"/>            
        </StackPanel>

    </Grid>
</Window>