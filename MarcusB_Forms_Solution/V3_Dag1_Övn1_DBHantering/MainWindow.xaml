<Window x:Class="V3_Dag1_Övn1_DBHantering.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:V3_Dag1_Övn1_DBHantering"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Loaded ="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>            
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Katt -->
        <Label Grid.Row="0" 
               Grid.Column="0" 
               Content="Välj argument till query:"
               VerticalAlignment="Center"/>
        <Grid  
            Grid.Row="0"
            Grid.Column="1"
            Margin="5">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Rubriker -->
            <Label Grid.Row="0" 
                   Grid.Column="0" 
                   Margin="5,0,0,0" 
                   Content="Välj kolumn:"
                   HorizontalAlignment="Left"/>
            <Label Grid.Row="0" 
                   Grid.Column="1" 
                   Margin="5,0,0,0" 
                   Content="Välj operator:"
                   HorizontalAlignment="Left"/>
            <Label Grid.Row="0" 
                   Grid.Column="2" 
                   Margin="5,0,0,0" 
                   Content="Fyll i värde:"
                   HorizontalAlignment="Left"/>

            <!-- Lägg till knapp -->
            <Button x:Name="btnAddCondition"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="3"
                    Margin="5"
                    Content="Lägg till villkor"                    
                    Click="btnAddCondition_Click"/>


            <!-- Värde val -->
            <ComboBox x:Name="cmbColumnType"
                      Grid.Row="1"
                      Grid.Column="0" 
                      Margin="5,0,0,0"                       
                      SelectedIndex="0">
                <ComboBoxItem Content=""/>
                <ComboBoxItem Content="Namn"/>
                <ComboBoxItem Content="Ålder"/>
                <ComboBoxItem Content="Färg"/>
                <ComboBoxItem Content="Katthem"/>
                <ComboBoxItem Content="Stad"/>
            </ComboBox>

            <ComboBox x:Name="cmbOperatorType"
                      Grid.Row="1"
                      Grid.Column="1" 
                      Margin="5,0,0,0"                       
                      SelectedIndex="0">
                <ComboBoxItem Content=""/>
                <ComboBoxItem Content="&lt;"/>
                <ComboBoxItem Content="&gt;"/>
                <ComboBoxItem Content="="/>
                <ComboBoxItem Content="!="/>
                <ComboBoxItem Content="&lt;="/>
                <ComboBoxItem Content="&gt;="/>
                <ComboBoxItem Content="like"/>
            </ComboBox>

            <TextBox x:Name="txtArgumentValue"
                     Grid.Row="1"
                     Grid.Column="2"
                     Margin="5,0,0,0"/>

        </Grid>
        

        <!-- SELECT-uttryck -->
        <Label Grid.Row="1" 
               Grid.Column="0" 
               Content="SELECT:"
               VerticalAlignment="Top"/>
        <Grid Grid.Row="1" 
              Grid.Column="1" 
              Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtSelect" 
                     Grid.Column="0" 
                     Height="60"
                     AcceptsReturn="True" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="btnRun" 
                    Grid.Column="1" 
                    Content="Kör" 
                    Margin="10,0,0,0"
                    Height="60" 
                    Click="btnRun_Click"/>
        </Grid>
        <!-- Resultat -->
        <Label Grid.Row="2" 
               Grid.Column="0" 
               Content="Resultat:"
               VerticalAlignment="Top" 
               Margin="0,15,0,0"/>
        <TextBox x:Name="txtResult" 
                 Grid.Row="2" 
                 Grid.Column="1" 
                 Margin="5,15,5,5"
                 IsReadOnly="True" 
                 AcceptsReturn="True" 
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" 
                 HorizontalScrollBarVisibility="Auto"/>
    </Grid>

</Window>