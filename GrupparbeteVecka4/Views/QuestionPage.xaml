<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GrupparbeteVecka4.Views.QuestionPage"
    Title="Quiz"
    Shell.NavBarIsVisible="False"
    Background="{StaticResource LiveBackground}">

    <Grid Padding="15" RowDefinitions="Auto, *, Auto">

        <!-- ========================= -->
        <!-- ÖVRE INFORMATION (CENTRERAD) -->
        <!-- ========================= -->
        <Grid
            Grid.Row="0"
            HorizontalOptions="Center"
            MaximumWidthRequest="250"
            WidthRequest="300"
            ColumnDefinitions="*, *"
            RowDefinitions="Auto, Auto">

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Text="{Binding QuestionProgressText}"
                Style="{StaticResource SubHeaderLabelStyle}"
                HorizontalOptions="Start" />

            <Label
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding QuizScoreText}"
                Style="{StaticResource SubHeaderLabelStyle}"
                HorizontalOptions="End" />

            <Label
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding TimerText}"
                Style="{StaticResource SubHeaderLabelStyle}"
                HorizontalOptions="End" />
        </Grid>


        <!-- ================================================= -->
        <!-- FRÅGELÄGE                                        -->
        <!-- ================================================= -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding IsQuestionVisible}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="600"
            Spacing="8">

            <!-- KATEGORI -->
            <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Kategori:" Style="{StaticResource SubHeaderLabelStyle}" FontSize="13" />
                <Label Text="{Binding CategoryName}" Style="{StaticResource DefaultLabelStyle}" FontAttributes="Bold" FontSize="13" />
            </HorizontalStackLayout>

            <!-- BILD -->
            <Image
                Source="{Binding CategoryImage}"
                HeightRequest="140"
                WidthRequest="220"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <!-- FRÅGETEXT -->
            <Label
                Text="{Binding QuestionText}"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="{StaticResource HeaderTextColor}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,5,0,10" />

            <!-- SVARSALTERNATIV -->
            <Grid
                RowDefinitions="Auto, Auto"
                ColumnDefinitions="*, *"
                RowSpacing="10"
                ColumnSpacing="10"
                HorizontalOptions="Fill">

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding Answer1Text}"
                    Command="{Binding AnswerCommand}"
                    CommandParameter="{Binding Answer1}"
                    Style="{StaticResource AnswerButtonStyle}" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding Answer2Text}"
                    Command="{Binding AnswerCommand}"
                    CommandParameter="{Binding Answer2}"
                    Style="{StaticResource AnswerButtonStyle}" />

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding Answer3Text}"
                    Command="{Binding AnswerCommand}"
                    CommandParameter="{Binding Answer3}"
                    Style="{StaticResource AnswerButtonStyle}" />

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding Answer4Text}"
                    Command="{Binding AnswerCommand}"
                    CommandParameter="{Binding Answer4}"
                    Style="{StaticResource AnswerButtonStyle}" />
            </Grid>

        </VerticalStackLayout>


        <!-- ================================================= -->
        <!-- SVARSLÄGE                                        -->
        <!-- ================================================= -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding IsAnswerVisible}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="500"
            Spacing="12">

            <Label
                Text="{Binding AnswerResultText}"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{Binding AnswerResultColor}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                Text="{Binding CorrectAnswerText}"
                Style="{StaticResource SubHeaderLabelStyle}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                Text="{Binding PointsText}"
                Style="{StaticResource DefaultLabelStyle}"
                HorizontalOptions="Center" />

            <Button
                Text="Nästa fråga →"
                Command="{Binding NextQuestionCommand}"
                Style="{StaticResource DefaultButtonStyle}"
                HorizontalOptions="Center"
                WidthRequest="200"
                Margin="0,10,0,0" />

        </VerticalStackLayout>


        <!-- ================================================= -->
        <!-- NEDRE INFORMATION                                 -->
        <!-- ================================================= -->
        <Label
            Grid.Row="2"
            Text="{Binding FooterText}"
            Style="{StaticResource DefaultLabelStyle}"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

    </Grid>
</ContentPage>