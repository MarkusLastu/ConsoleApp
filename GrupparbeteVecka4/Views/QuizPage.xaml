<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GrupparbeteVecka4.Views.QuizPage"
             Title="QuizPage"
             Background="{StaticResource LiveBackground}">
    <Grid RowDefinitions="*, Auto" Padding="20">

        <!-- ÖVRE INNEHÅLL (Rad 0) -->
        <VerticalStackLayout Grid.Row="0"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12">
            <Label Text="Nytt spel!"
                   Style="{StaticResource HeaderLabelStyle}" />

            <Label Text="Välj spelare för ditt quiz"
                   Style="{StaticResource SubHeaderLabelStyle}" />

            <!-- SelectedItem styr automatiskt IsPlayerSelected i ViewModel -->
            <Picker Title="Välj spelare"
                    ItemsSource="{Binding Players}"
                    ItemDisplayBinding="{Binding PlayerName}"
                    SelectedItem="{Binding SelectedPlayer}"
                    Style="{StaticResource DefaultPickerStyle}"/>

            <Label Text="Antal frågor"
                   Style="{StaticResource DefaultLabelStyle}" />

            <Picker Title="Välj antal frågor"
                    ItemsSource="{Binding QuestionCounts}"
                    SelectedItem="{Binding NumberOfQuestions}"
                    Style="{StaticResource DefaultPickerStyle}" />

            <!-- IsVisible styrs dynamiskt från ViewModel -->
            <Button Text="Starta nytt spel"
                    Command="{Binding StartQuizCommand}"
                    Style="{StaticResource DefaultButtonStyle}"
                    BackgroundColor="{DynamicResource PrimaryButtonColor}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    BorderColor="{DynamicResource PrimaryBorderColor}"
                    BorderWidth="{DynamicResource PrimaryBorderWidth}"
                    IsVisible="{Binding IsPlayerSelected}" />
        </VerticalStackLayout>

        <!-- NEDRE KNAPPAR (Rad 1) -->
        <Grid Grid.Row="1" HorizontalOptions="Fill" VerticalOptions="End" Margin="0,10,0,0">
            <!-- Bakåtknapp kopplad till BackCommand -->
            <Button Text="← Bakåt"
                    Command="{Binding BackCommand}"
                    HeightRequest="40"
                    WidthRequest="90"
                    FontSize="13"
                    BackgroundColor="{StaticResource PrimaryButtonColor}"
                    TextColor="{StaticResource PrimaryTextColor}"
                    CornerRadius="8"
                    HorizontalOptions="Start" />

            <!-- Historikknapp kopplad till HistoryCommand och IsPlayerSelected -->
            <Button Text="Historik"
                    Command="{Binding HistoryCommand}"
                    HeightRequest="40"
                    WidthRequest="120"
                    FontSize="13"
                    BackgroundColor="{DynamicResource PrimaryButtonColor}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    BorderColor="{DynamicResource PrimaryBorderColor}"
                    BorderWidth="{DynamicResource PrimaryBorderWidth}"
                    CornerRadius="8"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsPlayerSelected}" />
        </Grid>

    </Grid>
</ContentPage>