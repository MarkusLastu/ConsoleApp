<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GrupparbeteVecka4.Views.QuizPage"
             Title="QuizPage"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource LiveBackground}">

    <Grid RowDefinitions="Auto, *" Padding="20">

        <!-- BAKÅTKNAPP (Rad 0 - Högst upp till vänster) -->
        <HorizontalStackLayout Grid.Row="0" Margin="0,0,0,10">
            <Button Text="← Bakåt"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource DefaultButtonStyle}"
                    HeightRequest="36"
                    WidthRequest="80"
                    FontSize="12"
                    CornerRadius="8"
                    HorizontalOptions="Start" />
        </HorizontalStackLayout>

        <!-- ÖVRE INNEHÅLL (Rad 1 - Centrerat i resten av skärmen) -->
        <VerticalStackLayout Grid.Row="1"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12">

            <Label Text="Nytt spel!"
                   Style="{StaticResource HeaderLabelStyle}" />

            <!-- Spelarkontroll -->
            <Picker Title="Välj spelare"
                    ItemsSource="{Binding Players}"
                    ItemDisplayBinding="{Binding PlayerName}"
                    SelectedItem="{Binding SelectedPlayer}"
                    Style="{StaticResource DefaultPickerStyle}"/>

            <!-- Speltyp -->
            <Picker Title="Välj typ av spel"
                    ItemsSource="{Binding QuizTypes}"
                    ItemDisplayBinding="{Binding QuizTypeText}"
                    SelectedItem="{Binding SelectedQuizType}"
                    Style="{StaticResource DefaultPickerStyle}"/>

            <!-- Antal frågor (Syns vid klassiskt spel) -->
            <Picker Title="Välj antal frågor"
                    ItemsSource="{Binding QuestionsCount}"
                    SelectedItem="{Binding NumberOfQuestions}"
                    Style="{StaticResource DefaultPickerStyle}"
                    IsVisible="{Binding QuizTypeClassic}" />

            <!-- Antal sekunder (Syns vid tidsbaserat spel) -->
            <Picker Title="Välj antal sekunder"
                    ItemsSource="{Binding SecondsCount}"
                    SelectedItem="{Binding NumberOfSeconds}"
                    Style="{StaticResource DefaultPickerStyle}"
                    IsVisible="{Binding QuizTypeTimed}" />

            <!-- Startknapp -->
            <Button Text="Starta nytt spel"
                    Command="{Binding StartQuizCommand}"
                    Style="{StaticResource DefaultButtonStyle}"
                    IsVisible="{Binding IsPlayerSelected}"
                    Margin="0,10,0,0" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>