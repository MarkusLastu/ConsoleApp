<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GrupparbeteVecka4.Views.QuestionPresentation"
             Title="QuestionPresentation"
             BackgroundColor="#F5F5F5">
    
    <VerticalStackLayout
        VerticalOptions="Center"
        HorizontalOptions="Center">
        <!-- Rubrik -->
            <Label Text="Quiz"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#1F1F1F"
                   HorizontalOptions="Center" />
            <Label 
                Text="{Binding QuestionCount}"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

        <!-- Kategori -->

        <Label 
            Text="Kategori:"                        
            FontSize="18"
            FontAttributes="Bold"
            TextColor="#1F1F1F"
            HorizontalOptions="Center"/>
        <Label 
            Text="{Binding CategoryText}"                        
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Image
            Source="{Binding CategoryImage}"
            Height = "200"
            Aspect="AspectFit"/>

        <!-- Fråga -->
        
        <Label 
            Text="{Binding QuestionText}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <!-- Svarsalternativ -->
        <Grid
            RowDefinitions="*,*"
            ColumnDefinitions="200, 200"
            ColumnSpacing="10"
            RowSpacing="10">

            <Button Text="{Binding Answer1}"
                    Grid.Row="0"
                    Grid.Column="0"    
                    Command="{Binding AnswerCommand}"
                    CommandParameter="Answer1"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12" />
            <Button Text="{Binding Answer2}"
                    Grid.Row="0"
                    Grid.Column="1"    
                    Command="{Binding AnswerCommand}"
                    CommandParameter="Answer2"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12" />
            <Button Text="{Binding Answer3}"
                    Grid.Row="1"
                    Grid.Column="0"    
                    Command="{Binding AnswerCommand}"
                    CommandParameter="Answer3"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12" />
            <Button Text="{Binding Answer4}"
                    Grid.Row="1"
                    Grid.Column="1"    
                    Command="{Binding AnswerCommand}"
                    CommandParameter="Answer4"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>