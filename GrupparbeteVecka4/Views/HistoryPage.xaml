<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GrupparbeteVecka4.ViewModels"
             xmlns:models="clr-namespace:GrupparbeteVecka4.Models"
             x:Class="GrupparbeteVecka4.Views.HistoryPage"
             Title="HistoryPage"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource LiveBackground}">

    <Grid RowDefinitions="Auto, *" Padding="15">

        <!-- BAKÅTKNAPP (Högst upp till vänster) -->
        <HorizontalStackLayout Grid.Row="0" Margin="0,0,0,10">
            <Button Text="← Bakåt"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource DefaultButtonStyle}"
                    HeightRequest="36"
                    WidthRequest="80"
                    FontSize="12"
                    CornerRadius="8"
                    HorizontalOptions="Start" />
        </HorizontalStackLayout>

        <!-- INNEHÅLL -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" MaximumWidthRequest="280">

                <!-- RUBRIK MED DYNAMISK BAKGRUND -->
                <Border Padding="12,6"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{DynamicResource PrimaryButtonColor}"
                        Stroke="{DynamicResource PrimaryBorderColor}"
                        StrokeThickness="{DynamicResource PrimaryBorderWidth}"
                        HorizontalOptions="Center"
                        Margin="0,0,0,5">

                    <Label Text="Spelhistorik"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- LISTA MED HISTORIK -->
                <CollectionView 
                    x:Name="QuizHistoryCollection"
                    ItemsSource="{Binding QuizHistories}"
                    SelectionMode="Single"
                    SelectionChangedCommand="{Binding SelectQuizCommand}"
                    SelectionChangedCommandParameter="{Binding SelectedItem, Source={x:Reference QuizHistoryCollection}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:QuizHistory">
                            <Border Margin="0,0,0,8"
                                    Padding="10,8"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{DynamicResource PrimaryButtonColor}"
                                    Stroke="{DynamicResource PrimaryBorderColor}"
                                    StrokeThickness="{DynamicResource PrimaryBorderWidth}">

                                <Grid ColumnDefinitions="*, Auto">
                                    <!-- Vänster sida: Datum, Speltyp & Poäng -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding FormattedDate}"
                                               FontSize="12"
                                               TextColor="{DynamicResource PrimaryTextColor}"
                                               Opacity="0.8" />

                                        <Label Text="{Binding QuizTypeText}"
                                               FontSize="11"
                                               FontAttributes="Italic"
                                               TextColor="{DynamicResource PrimaryTextColor}"
                                               Opacity="0.6" />

                                        <Label Text="{Binding Score, StringFormat='Poäng: {0}'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource PrimaryTextColor}"
                                               Margin="0,2,0,0" />
                                    </VerticalStackLayout>

                                    <!-- Höger sida: Antal frågor -->
                                    <Label Grid.Column="1"
                                           Text="{Binding TotalQuestions, StringFormat='{0} frågor'}"
                                           FontSize="13"
                                           TextColor="{DynamicResource PrimaryTextColor}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- OM HISTORIKEN ÄR TOM -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" HorizontalOptions="Center">
                            <Label Text="Ingen historik hittades."
                                   FontSize="14"
                                   TextColor="{DynamicResource PrimaryTextColor}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>