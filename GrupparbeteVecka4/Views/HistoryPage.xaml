<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GrupparbeteVecka4.Views.HistoryPage"
             Title="Historik">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *" 
              Padding="15, 10" 
              BackgroundColor="{DynamicResource PrimaryButtonColor}">

            <Button Text="← Bakåt"
                    Clicked="OnBackButtonClicked"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    FontSize="16" />

            <Label Grid.Column="1"
                   Text="Spelhistorik"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource PrimaryTextColor}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </Grid>

        <!-- Lista över spelomgångar -->
        <Grid Grid.Row="1" Padding="16">
            <CollectionView x:Name="HistoryCollectionView"
                            ItemsSource="{Binding QuizHistories}">

                <!-- SÄTTER ETT GARANTERAT MELLANRUM MELLAN KORTEN -->
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <!-- Tom vy -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label Text="Ingen spelhistorik hittades."
                               FontSize="16"
                               TextColor="{DynamicResource SubHeaderTextColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- Historik-kort -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18, 16"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource PrimaryBorderColor}"
                                StrokeThickness="{DynamicResource PrimaryBorderWidth}"
                                BackgroundColor="{DynamicResource PrimaryButtonColor}">
                            <Grid ColumnDefinitions="*, Auto">
                                <!-- Vänster sida: Datum & Tid -->
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="{Binding FormattedDate}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource PrimaryTextColor}" />
                                    <Label Text="{Binding TotalQuestions, StringFormat='Antal frågor: {0}'}"
                                           FontSize="14"
                                           TextColor="{DynamicResource PrimaryTextColor}"
                                           Opacity="0.8" />
                                </VerticalStackLayout>

                                <!-- Höger sida: Poäng -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label Text="{Binding ScoreText}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource PrimaryTextColor}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>
</ContentPage>