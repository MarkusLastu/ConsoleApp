<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"              
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GrupparbeteVecka4.ViewModels"
             x:Class="GrupparbeteVecka4.Views.ProfileSelectPage"
             Title="Välj eller skapa profil"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource LiveBackground}">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20">

        <!-- Bakåtknapp högst upp till vänster -->
        <HorizontalStackLayout Grid.Row="0" Margin="0,0,0,10">
            <Button Text="← Bakåt"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource DefaultButtonStyle}"
                    HeightRequest="36"
                    WidthRequest="80"
                    FontSize="12"
                    CornerRadius="8"
                    HorizontalOptions="Start" />
        </HorizontalStackLayout>

        <!-- Rubrik -->
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="6" Margin="0,0,0,15">
            <Label Text="Profilhantering"
                   Style="{StaticResource HeaderLabelStyle}"
                   HorizontalOptions="Center" />

            <Label Text="Välj eller skapa en spelare för att se historik"
                   Style="{StaticResource SubHeaderLabelStyle}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Skapa ny spelare-sektion -->
        <Border Grid.Row="2"
                Padding="16"
                Margin="0,0,0,15"
                StrokeShape="RoundRectangle 12"
                Stroke="{DynamicResource PrimaryBorderColor}"
                StrokeThickness="{DynamicResource PrimaryBorderWidth}"
                BackgroundColor="{DynamicResource PrimaryButtonColor}">
            <VerticalStackLayout Spacing="10" Padding="0">
                <Label Text="Skapa ny spelare"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource PrimaryTextColor}" />

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Entry Placeholder="Ange spelarnamn..."
                           Text="{Binding NewPlayerName}"
                           Style="{StaticResource DefaultEntryStyle}" />

                    <Button Grid.Column="1"
                            Text="Skapa"
                            Command="{Binding CreatePlayerCommand}"
                            Style="{StaticResource DefaultButtonStyle}"
                            WidthRequest="90" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Lista över befintliga spelare -->
        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding Players}"
                            SelectedItem="{Binding SelectedPlayer}"
                            SelectionMode="Single">

                <!-- Minskat avstånd mellan varje spelarkort (från 18 till 8px) -->
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Inga spelare hittades. Skapa en ovan!"
                               Style="{StaticResource DefaultLabelStyle}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- Spelarkort -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12, 10"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource PrimaryBorderColor}"
                                StrokeThickness="{DynamicResource PrimaryBorderWidth}"
                                BackgroundColor="{DynamicResource PrimaryButtonColor}">

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">

                                <!-- Profilbild / Cirkulär Avatar -->
                                <Border Grid.Column="0"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        StrokeShape="RoundRectangle 17"
                                        Stroke="{DynamicResource PrimaryBorderColor}"
                                        StrokeThickness="1"
                                        BackgroundColor="#20FFFFFF"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="👤"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Spelarnamn -->
                                <Label Grid.Column="1"
                                       Text="{Binding PlayerName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryTextColor}"
                                       VerticalOptions="Center" />

                                <!-- Välj-indikator -->
                                <Label Grid.Column="2"
                                       Text="Välj →"
                                       FontSize="13"
                                       TextColor="{DynamicResource PrimaryTextColor}"
                                       Opacity="0.8"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>
</ContentPage>