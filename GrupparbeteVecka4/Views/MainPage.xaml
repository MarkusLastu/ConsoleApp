<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GrupparbeteVecka4.Views.MainPage"
             Title="Grupparbete Vecka 4: QuizAppen"
             Background="{StaticResource LiveBackground}">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20">

        <!-- Rubriker -->
        <VerticalStackLayout Grid.Row="1" Spacing="5" Margin="0,0,0,20" HorizontalOptions="Center">
            <Label Text="Quiz Appen"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource HeaderTextColor}"
                   HorizontalOptions="Center" />

            <Label Text="Välkommen! Välj ett alternativ nedan."
                   FontSize="15"
                   TextColor="{StaticResource SubHeaderTextColor}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Menyknappar -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="15"
                                 VerticalOptions="Center"
                                 MaximumWidthRequest="320">

                <Button Text="Starta Quiz"
                        Clicked="OnButtonClicked"
                        CommandParameter="QuizPage"
                        BackgroundColor="{DynamicResource PrimaryButtonColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        BorderColor="{DynamicResource PrimaryBorderColor}"
                        BorderWidth="{DynamicResource PrimaryBorderWidth}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="55" CornerRadius="12" />

                <Button Text="Profil"
                        Clicked="OnButtonClicked"
                        CommandParameter="ProfilePage"
                        BackgroundColor="{DynamicResource PrimaryButtonColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        BorderColor="{DynamicResource PrimaryBorderColor}"
                        BorderWidth="{DynamicResource PrimaryBorderWidth}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="55" CornerRadius="12" />

                <Button Text="Historik"
                        Clicked="OnButtonClicked"
                        CommandParameter="HistoryPage"
                        BackgroundColor="{DynamicResource PrimaryButtonColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        BorderColor="{DynamicResource PrimaryBorderColor}"
                        BorderWidth="{DynamicResource PrimaryBorderWidth}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="55" CornerRadius="12" />

                <Button Text="Inställningar"
                        Clicked="OnButtonClicked"
                        CommandParameter="SettingsPage"
                        BackgroundColor="{DynamicResource PrimaryButtonColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        BorderColor="{DynamicResource PrimaryBorderColor}"
                        BorderWidth="{DynamicResource PrimaryBorderWidth}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="55" CornerRadius="12" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
