<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GrupparbeteVecka4.Views.MainPage"
             Title="Grupparbete Vecka 4: QuizAppen"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, *" 
          Padding="30">

        <!-- Rubrik och undertext -->
        <VerticalStackLayout Grid.Row="0" 
                             Spacing="5" 
                             Margin="0,40,0,0" 
                             HorizontalOptions="Center">
            <Label Text="Huvudmeny"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#1F1F1F"
                   HorizontalOptions="Center" />

            <Label Text="Välj ett alternativ nedan"
                   FontSize="16"
                   TextColor="#666666"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Menyknappar -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="15"
                             VerticalOptions="Center"
                             MaximumWidthRequest="320">

            <Button Text="Starta Quiz"
                    Clicked="OnButtonClicked"
                    CommandParameter="QuizPage"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12" />

            <Button Text="Profil"
                    Clicked="OnButtonClicked"
                    CommandParameter="ProfilePage"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12" />

            <Button Text="Historik"
                    Clicked="OnButtonClicked"
                    CommandParameter="HistoryPage"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12" />

            <Button Text="Inställningar"
                    Clicked="OnButtonClicked"
                    CommandParameter="SettingsPage"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="12" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
