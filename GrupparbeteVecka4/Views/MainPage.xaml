<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GrupparbeteVecka4.Views.MainPage"
             Title="Grupparbete Vecka 4: QuizAppen"
             Background="{StaticResource LiveBackground}">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20">

        <!-- Rubriker -->
        <VerticalStackLayout Grid.Row="1" Spacing="5" Margin="0,0,0,20" HorizontalOptions="Center">
            <Label Text="Quiz Appen"
                   Style="{StaticResource HeaderLabelStyle}"
                   HorizontalOptions="Center" />

            <Label Text="Välkommen! Välj ett alternativ nedan."
                   Style="{StaticResource SubHeaderLabelStyle}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Menyknappar -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="15"
                                 VerticalOptions="Center"
                                 MaximumWidthRequest="320">

                <Button Text="Starta Quiz"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="QuizPage"
                        Style="{StaticResource DefaultButtonStyle}" />

                <Button Text="Profil"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="ProfileSelectPage"
                        Style="{StaticResource DefaultButtonStyle}" />

                <Button Text="Inställningar"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="SettingsPage"
                        Style="{StaticResource DefaultButtonStyle}" />
                
                <Button Text="❌ Avsluta"
                        Command="{Binding ExitCommand}"
                        BackgroundColor="#D32F2F"
                        TextColor="White"
                        BorderColor="#9A0007"
                        BorderWidth="1.5"
                        HeightRequest="42"
                        WidthRequest="120"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="0,0,0,15" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>