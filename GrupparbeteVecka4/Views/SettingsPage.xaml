<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GrupparbeteVecka4.ViewModels"
             x:Class="GrupparbeteVecka4.Views.SettingsPage"
             Title="SettingsPage"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource LiveBackground}">

    <Grid Padding="15">
        <ScrollView Margin="0,0,0,50">
            <!-- Minskat Spacing mellan alla temakort från 15 till 8 -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                <!-- RUBRIK MED DYNAMISK BAKGRUND -->
                <Border Padding="12,6"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{DynamicResource PrimaryButtonColor}"
                        Stroke="{DynamicResource PrimaryBorderColor}"
                        StrokeThickness="{DynamicResource PrimaryBorderWidth}"
                        HorizontalOptions="Center"
                        Margin="0,0,0,5">
                    
                    <Label Text="Välj Knapptema"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- TEMA 1: Mörka Knappar (Smalare kort: 240px, smalare knapp: 55px) -->
                <Border Padding="8,10" 
                        StrokeShape="RoundRectangle 10" 
                        BackgroundColor="#1E1E2E"
                        MaximumWidthRequest="240"
                        WidthRequest="240"
                        HorizontalOptions="Center">
                    <Grid ColumnDefinitions="*, Auto">
                        
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Mörka Knappar" 
                                   FontSize="15" 
                                   FontAttributes="Bold" 
                                   TextColor="White" />
                            <Label Text="Vit stil" 
                                   FontSize="15" 
                                   TextColor="White" />
                        </VerticalStackLayout>
                        
                        <Button Grid.Column="1" 
                                Text="Välj" 
                                Command="{Binding DarkThemeCommand}"
                                BackgroundColor="Black"
                                TextColor="White"
                                BorderColor="White"
                                BorderWidth="2"
                                FontAttributes="Bold"
                                CornerRadius="6"
                                HeightRequest="32"
                                WidthRequest="55"
                                FontSize="12"
                                Padding="0" />
                    </Grid>
                </Border>

                <!-- TEMA 2: Frostat Glas (Smalare kort: 240px, smalare knapp: 55px) -->
                <Border Padding="8,10" 
                        StrokeShape="RoundRectangle 10" 
                        BackgroundColor="#40FFFFFF"
                        Stroke="Black"
                        StrokeThickness="2"
                        MaximumWidthRequest="240"
                        WidthRequest="240"
                        HorizontalOptions="Center">
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Frostat Glas" 
                                   FontSize="15" 
                                   FontAttributes="Bold" 
                                   TextColor="Black" />
                            <Label Text="Helsvart kantlinje" 
                                   FontSize="14" 
                                   TextColor="Black" />
                        </VerticalStackLayout>
                        
                        <Button Grid.Column="1" 
                                Text="Välj" 
                                Command="{Binding GlassThemeCommand}"
                                BackgroundColor="#40FFFFFF"
                                TextColor="Black"
                                BorderColor="Black"
                                BorderWidth="2"
                                CornerRadius="6"
                                HeightRequest="32"
                                WidthRequest="55"
                                FontSize="12"
                                Padding="0" />
                    </Grid>
                </Border>

                <!-- TEMA 3: Skogsgrön (Smalare kort: 240px, smalare knapp: 55px) -->
                <Border Padding="8,10" 
                        StrokeShape="RoundRectangle 10" 
                        BackgroundColor="#E8F5E9"
                        MaximumWidthRequest="240"
                        WidthRequest="240"
                        HorizontalOptions="Center">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Skogsgrön" 
                                   FontSize="15" 
                                   FontAttributes="Bold" 
                                   TextColor="#1B4332" />
                            <Label Text="grön nyans" 
                                   FontSize="15" 
                                   TextColor="#40916C" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" 
                                Text="Välj" 
                                Command="{Binding GreenThemeCommand}"
                                BackgroundColor="#2E7D32"
                                TextColor="White"
                                CornerRadius="6"
                                HeightRequest="32"
                                WidthRequest="55"
                                FontSize="12"
                                Padding="0" />
                    </Grid>
                </Border>

                <!-- Förhandsvisning -->
                <Border Padding="8,10" 
                        StrokeShape="RoundRectangle 10" 
                        BackgroundColor="#20FFFFFF"
                        MaximumWidthRequest="240"
                        WidthRequest="240"
                        HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Förhandsvisning:" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="Black" 
                               HorizontalOptions="Center" />

                        <Button Text="Knapp Tema"
                                InputTransparent="True"
                                Style="{StaticResource DefaultButtonStyle}"
                                WidthRequest="150"
                                HeightRequest="36"
                                FontSize="13"
                                FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bakåtknapp -->
        <Button Text="← Bakåt"
                Command="{Binding BackCommand}"
                Style="{StaticResource DefaultButtonStyle}"
                HeightRequest="36"
                WidthRequest="80"
                FontSize="12"
                CornerRadius="8"
                HorizontalOptions="Start"
                VerticalOptions="End" />
    </Grid>
</ContentPage>