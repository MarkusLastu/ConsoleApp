<Window x:Class="V2_Dag4_GrpOvn_Pizza.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:V2_Dag4_GrpOvn_Pizza"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <!-- Rader -->
    <Grid Margin="20">
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <!-- GroupBox -->

            <RowDefinition Height="Auto"/>
            <!-- Knapp -->

            <RowDefinition Height="Auto"/>
            <!-- Plats för ComboBox -->

            <RowDefinition Height="*"/>
            <!-- Tom yta -->

        </Grid.RowDefinitions>

        <!-- Kolumner -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- ===== GROUPBOX MED RADIOBUTTONS ===== -->
        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Width="Auto"
            Margin="0,5">

            <GroupBox.Header>
                <TextBlock Text="Välj storlek på pizza" 
                    FontSize="16" 
                    FontWeight="Bold"/>
            </GroupBox.Header>
            
            <StackPanel Height="Auto">
                <RadioButton x:Name="rbSmall"
                    Content="Small pizza"
                    Margin="5"/>
                <RadioButton x:Name="rbLarge"
                    Content="Large Pizza"
                    Margin="5"/>
                <RadioButton x:Name="rbExtraLarge"
                    Content="Extra Large Pizza"
                    Margin="5"/>
                </StackPanel>
        </GroupBox>
        <!-- ===== KNAPP SOM HÄMTAR VÄRDET ===== -->
        <ComboBox x:Name="cmbPizza"
            DisplayMemberPath="DisplayName"
            Grid.Column="0"
            Grid.Row="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="242" 
            Height="32"/>

        <!-- Beställ knapp -->
        <Button x:Name="cmdBestall" 
            Content="Beställ" 
            Click="cmdBestall_Click"
            Width="100" 
            Height="40" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Grid.Column="2"
            Grid.Row="0"/>

        <!-- TextBox -->
        <TextBox x:Name="txtResultat" 
            Grid.Column="2"
            Grid.Row="1"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            TextWrapping="Wrap" 
            Text="TextBox" 
            Width="120"/>
    </Grid>


</Window>
